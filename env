#--------------------------------------------------------------------
# Example Environment Configuration file
#
# This file can be used as a starting point for your own
# custom .env files, and contains most of the possible settings
# available in a default install.
#
# By default, all of the settings are commented out. If you want
# to override the setting, you must un-comment it by removing the '#'
# at the beginning of the line.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

# CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# app.baseURL = ''
# If you have trouble with `.`, you could also use `_`.
# app_baseURL = ''
# app.forceGlobalSecureRequests = false
# app.CSPEnabled = false
# GOOGLE_CLIENT_ID = ''

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

# database.default.hostname = localhost
# database.default.database = ci4
# database.default.username = root
# database.default.password = root
# database.default.DBDriver = MySQLi
# database.default.DBPrefix =
# database.default.port = 3306

# If you use MySQLi as tests, first update the values of Config\Database::$tests.
# database.tests.hostname = localhost
# database.tests.database = ci4_test
# database.tests.username = root
# database.tests.password = root
# database.tests.DBDriver = MySQLi
# database.tests.DBPrefix =
# database.tests.charset = utf8mb4
# database.tests.DBCollat = utf8mb4_general_ci
# database.tests.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# encryption.key =

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = null

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# logger.threshold = 4

#--------------------------------------------------------------------
# API CLIENT
#--------------------------------------------------------------------

# apiClient.baseUrl = 'http://localhost:8180'
# apiClient.appName = 'API Client'
# apiClient.apiPrefix = '/api/v1'
# apiClient.logRequests = false
#
# API App Key — raises rate limit from 60 req/min (IP-based) to 600 req/min (key-based).
# Create a key at /admin/api-keys, then set it here.
# Omit rather than set an invalid value — a wrong key returns 401 on every request.
# apiClient.appKey = apk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Optional: Override the webapp base URL (used in email links, password reset redirects)
# WEBAPP_BASE_URL = 'http://localhost:8182'

#--------------------------------------------------------------------
# DOMAIN API CLIENT (optional — only when admin talks to a ci4-domain-starter)
#--------------------------------------------------------------------
# Configure these to wire a second backend in parallel to the hub. Modules
# scaffolded with `bash bin/make-module.sh ... --service=domain` will route
# their HTTP calls here instead of `apiClient.baseUrl`.
#
# domainApiClient.baseUrl = 'http://localhost:8190'
# domainApiClient.apiPrefix = '/api/v1'
# domainApiClient.appName = 'Domain Client'
# domainApiClient.logRequests = false
# domainApiClient.appKey = 'apk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'

#--------------------------------------------------------------------
# BFF API CLIENT (optional — only when a ci4-bff-starter is part of the stack)
#--------------------------------------------------------------------
# Leave bffApiClient.baseUrl empty (default) to disable BFF health monitoring.
# Set it to show a BFF health card on the admin dashboard.
#
# bffApiClient.baseUrl = 'http://localhost:8188'
# bffApiClient.apiPrefix = '/api/v1'
# bffApiClient.appName = 'BFF Gateway'
# bffApiClient.logRequests = false

# Maximum file upload size in bytes (applies to frontend validation + server rules)
# FILE_MAX_SIZE = 10485760
