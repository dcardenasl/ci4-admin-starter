includes:
    - phpstan-baseline.neon

parameters:
    level: 8
    paths:
        - app/Controllers
        - app/Filters
        - app/Helpers
        - app/Libraries
        - app/Modules
        - app/Services
        - app/Support
        - app/Traits
    parallel:
        jobSize: 20
        processTimeout: 600.0
        maximumNumberOfProcesses: 0
        minimumNumberOfJobsPerProcess: 2
        buffer: 134217728
    excludePaths:
        - vendor
        - writable
        - tests/_support
        - app/Views
    # Use bootstrap for constants and common CI4 functions discovery
    bootstrapFiles:
        - phpstan-bootstrap.php
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    # ignoreErrors limited to CI4 framework-dynamic patterns (not real bugs).
    ignoreErrors:
        # CI4 helper functions (loaded globally via spark/autoloader)
        - '#Function (esc|lang|service|helper|model|config|cache|view|is_cli|env|base_url|site_url|redirect|clean_path|log_message|old|cli|session|csrf_token|csrf_hash|csrf_field|csrf_meta|password_strength|sanitize_filename|route_to|url_is|request) not found#'
        # CI4 framework constants
        - '#Constant (APPPATH|FCPATH|ROOTPATH|WRITEPATH|ENVIRONMENT) not found#'
        # CI4 query builder + magic methods
        - '#Call to an undefined method CodeIgniter\\Database\\BaseBuilder::#'
        # CI4 Entity dynamic properties (Entity uses __get/__set)
        - '#Access to an undefined property App\\Entities\\.*::\$#'
        # Generic object access — appears when a service returns mixed-shape untyped data
        - '#Call to an undefined method object::#'
        - '#Access to an unknown class Config\\Services#'
        - '#Access to an undefined property object::#'
