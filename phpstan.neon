parameters:
    level: 5
    paths:
        - app/Controllers
        - app/Filters
        - app/Helpers
        - app/Libraries
        - app/Requests
        - app/Services
        - app/Support
    excludePaths:
        - app/Views
    bootstrapFiles:
        - phpstan-bootstrap.php
    scanFiles:
        - app/Config/ApiClient.php
        - app/Config/App.php
        - app/Config/Services.php
    treatPhpDocTypesAsCertain: false
