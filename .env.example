#--------------------------------------------------------------------
# REQUIRED CONFIGURATION
# Must be configured before the application can run
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# Environment & Base URL (REQUIRED)
#--------------------------------------------------------------------

CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8082/'
# Enable these in production behind HTTPS.
# app.forceGlobalSecureRequests = true
# app.CSPEnabled = true

#--------------------------------------------------------------------
# Session / Cookies
#--------------------------------------------------------------------

# Default: FileHandler (suitable for single-server deployments)
# session.driver = 'CodeIgniter\\Session\\Handlers\\FileHandler'
# session.savePath = '/absolute/path/to/writable/session'

# For horizontal scaling (load-balanced clusters):
# Use Redis: requires predis/predis in composer.json
# session.driver = 'CodeIgniter\\Session\\Handlers\\RedisHandler'
# session.savePath = 'tcp://redis:6379'

# Or use database:
# session.driver = 'CodeIgniter\\Session\\Handlers\\DatabaseHandler'
# session.savePath = 'sessions'

# Security
# cookie.secure = true
# WEBAPP_BASE_URL = 'https://yourdomain.com'

#--------------------------------------------------------------------
# API Client (REQUIRED)
# Backend API configuration - application will not work without these
#--------------------------------------------------------------------

apiClient.baseUrl = 'http://localhost:8080'
apiClient.apiPrefix = '/api/v1'

# OPTIONAL: App identification for higher rate limits (60 → 600 req/min)
# Generate a key via admin panel at /admin/api-keys
# apiClient.appKey = 'apk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'

# OPTIONAL: Custom app name and request logging
# apiClient.appName = 'CI4 Admin Starter'
# apiClient.logRequests = false

#--------------------------------------------------------------------
# Domain API Client (OPTIONAL)
# Second HTTP client targeting a ci4-domain-starter app. Only configure
# when the admin needs to talk to a domain backend in parallel to the hub
# (e.g. SubscriptionKit). Modules scaffolded with `--service=domain` route
# their calls here.
#--------------------------------------------------------------------

# domainApiClient.baseUrl = 'http://localhost:8090'
# domainApiClient.apiPrefix = '/api/v1'
# domainApiClient.appKey = 'apk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx'
# domainApiClient.appName = 'CI4 Admin Starter (domain)'
# domainApiClient.logRequests = false

#--------------------------------------------------------------------
# ENCRYPTION (REQUIRED)
# Generate a key using: php spark key:generate
#--------------------------------------------------------------------

encryption.key = ''

#--------------------------------------------------------------------
# OPTIONAL CONFIGURATION
# These can be left as defaults for development
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# Auth / Files
#--------------------------------------------------------------------

# Optional: Google OAuth configuration
# GOOGLE_CLIENT_ID = ''

# File upload limit: 10MB default (in bytes)
FILE_MAX_SIZE = 10485760

#--------------------------------------------------------------------
# Email / Notifications (OPTIONAL)
# Configure if you need to send emails
#--------------------------------------------------------------------

# SMTP_HOST = 'localhost'
# SMTP_USER = ''
# SMTP_PASS = ''
# SMTP_CRYPTO = 'tls'
# SMTP_PORT = 587
# EMAIL_FROM = ''
# EMAIL_FROM_NAME = 'CI4 Admin'
