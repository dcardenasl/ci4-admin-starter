{
    "name": "ci4-admin-starter",
    "private": true,
    "engines": {
        "node": "^22.22.1 || >=24"
    },
    "scripts": {
        "dev:css": "tailwindcss -i ./src/css/app.css -o ./public/assets/css/app.css --watch",
        "build:css": "tailwindcss -i ./src/css/app.css -o ./public/assets/css/app.css --minify",
        "build:vendor": "node scripts/build-vendor.js",
        "build:all": "npm run build:css && npm run build:vendor",
        "lint:js": "eslint public/assets/js/app.js",
        "lint:all": "eslint 'public/assets/js/**/*.js'",
        "prepare": "husky"
    },
    "dependencies": {
        "alpinejs": "^3.14.9",
        "lucide": "^1.17.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/cli": "^4.3.0",
        "eslint": "^10.4.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.7",
        "tailwindcss": "^4.3.1"
    },
    "lint-staged": {
        "public/assets/js/**/*.js": [
            "eslint --fix"
        ]
    }
}
