{
    "name": "ci4-admin-starter",
    "private": true,
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24"
    },
    "scripts": {
        "dev:css": "tailwindcss -i ./src/css/app.css -o ./public/assets/css/app.css --watch",
        "build:css": "tailwindcss -i ./src/css/app.css -o ./public/assets/css/app.css --minify",
        "build:vendor": "mkdir -p public/assets/vendor && cp node_modules/alpinejs/dist/cdn.min.js public/assets/vendor/alpine.min.js && cp node_modules/lucide/dist/umd/lucide.min.js public/assets/vendor/lucide.min.js",
        "build:all": "npm run build:css && npm run build:vendor",
        "lint:js": "eslint public/assets/js/app.js",
        "lint:all": "eslint 'public/assets/js/**/*.js'",
        "prepare": "husky"
    },
    "dependencies": {
        "alpinejs": "^3.14.9",
        "lucide": "^1.16.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@tailwindcss/cli": "^4.3.0",
        "eslint": "^10.4.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "tailwindcss": "^4.3.0"
    },
    "lint-staged": {
        "public/assets/js/**/*.js": [
            "eslint --fix"
        ]
    }
}
